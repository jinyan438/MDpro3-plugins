# Keep the launcher scripts usable on Windows: .bat/.ps1 must be checked out with CRLF
# (a .bat with bare LF line endings does not resolve its labels correctly).
*               text=auto

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.cs            text eol=crlf
*.json          text eol=crlf
*.md            text eol=lf
