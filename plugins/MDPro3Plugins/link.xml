<linker>
  <!--
    Unity's managed linker sees the data contract configuration types only through
    Mono's machine.config and otherwise removes them. WindBot uses
    DataContractJsonSerializer for its dialog file, so keep this reflection-only
    configuration surface in player builds.
  -->
  <assembly fullname="System.Runtime.Serialization">
    <namespace fullname="System.Runtime.Serialization.Configuration" preserve="all" />
  </assembly>
  <assembly fullname="Assembly-CSharp">
    <!-- JSON save fields and WindBot's executor discovery are accessed through reflection. -->
    <type fullname="MDPro3.Plugins.Features.StoryMode.StorySave" preserve="all" />
    <type fullname="MDPro3.Plugins.Features.StoryMode.StoryDeck" preserve="all" />
    <type fullname="MDPro3.Plugins.Features.StoryMode.StoryRules" preserve="all" />
    <type fullname="MDPro3.Plugins.Features.StoryMode.StoryExecutor" preserve="all" />
    <!-- Invoked from the editor's story submenu through reflection. -->
    <type fullname="MDPro3.UI.ServantUI.DeckEditorUI">
      <method name="OnHandTestSettings" />
    </type>
  </assembly>
</linker>
